# ==============================================================================
# ALPHAFORGE CONFIGURATION
# ==============================================================================

ENVIRONMENT=development
DEBUG=True
SECRET_KEY=alphaforge-institutional-secret-change-me-in-production-2026

# Execution Mode: PAPER (Default) or LIVE
EXECUTION_MODE=PAPER

# Initial Simulated Capital
INITIAL_CAPITAL=1000000.0
CURRENCY=INR

# Database: SQLite fallback default or PostgreSQL
DATABASE_URL=sqlite:///./alphaforge.db

# Redis
REDIS_URL=redis://localhost:6379/0

# Risk Engine Thresholds
MAX_PORTFOLIO_EXPOSURE=1.0
MAX_POSITION_WEIGHT=0.15
MAX_DAILY_LOSS_PCT=0.02
MAX_DRAWDOWN_PCT=0.15
MAX_LEVERAGE=1.0
MAX_ORDER_VALUE=200000.0
MAX_OPEN_POSITIONS=10

# Transaction Costs & Slippage (Quant Basis Points)
DEFAULT_SLIPPAGE_BPS=5.0
DEFAULT_COMMISSION_BPS=3.0
DEFAULT_EXCHANGE_FEE_BPS=0.35
DEFAULT_TAX_BPS=10.0

# Live Broker Credentials (Isolated)
BROKER_TYPE=MOCK_LIVE
BROKER_API_KEY=
BROKER_API_SECRET=
BROKER_ACCESS_TOKEN=
BROKER_USER_ID=
BROKER_LIVE_CONFIRMED=False

API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_PORT=3000
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
